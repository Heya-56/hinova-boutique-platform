{
  "name": "hinova-boutiques",
  "version": "1.0.0",
  "private": true,
  "description": "Générateur de boutiques en ligne multi-commerçants pour la Polynésie française — Cloudflare Workers + D1 + R2",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "db:local": "wrangler d1 execute hinova_boutiques --local --file=schema.sql",
    "db:remote": "wrangler d1 execute hinova_boutiques --remote --file=schema.sql",
    "test": "bash test/smoke.sh",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
